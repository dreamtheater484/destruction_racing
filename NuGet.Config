<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Offline only: Godot's bundled packages plus the local NuGet cache.
       Nothing is fetched from the internet; a missing package fails the restore. -->
  <packageSources>
    <clear />
    <add key="GodotBundled" value=".engine/godot/Godot_v4.7.2-stable_mono_win64/GodotSharp/Tools/nupkgs" />
    <add key="LocalCache" value="%USERPROFILE%/.nuget/packages" />
  </packageSources>
</configuration>
