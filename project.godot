; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Destruction Racing"
config/description="A spiritual successor to Destruction Derby 1 and 2."
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

DevTools="*res://src/Core/DevTools.cs"
GameSettings="*res://src/Core/GameSettings.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DestructionRacing"

[editor_plugins]

enabled=PackedStringArray("res://addons/autobake/plugin.cfg")

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.08, 0.08, 0.09, 1)
