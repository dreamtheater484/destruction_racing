@echo off
rem Builds and starts the M3 pileup stress test: twenty cars drive into the middle of the Bowl, a
rem twenty-first is dropped on the pile, then everyone lets go. Shows the frame rate and a PASS/FAIL verdict.
rem R = run it again, Esc = quit.
cd /d "%~dp0"
echo Building...
dotnet build DestructionRacing.csproj -nologo -v q
if errorlevel 1 (
  echo.
  echo Build failed - see the messages above.
  pause
  exit /b 1
)
if not exist ".engine\godot\Godot_v4.7.2-stable_mono_win64\Godot_v4.7.2-stable_mono_win64.exe" (
  echo Godot was not found in .engine\godot - see docs\DEVELOPMENT.md
  pause
  exit /b 1
)
echo Starting the pileup test...
start "" ".engine\godot\Godot_v4.7.2-stable_mono_win64\Godot_v4.7.2-stable_mono_win64.exe" --path . --log-file "out\last_run.log" -- --scene=res://scenes/test/PileupTest.tscn --visual
